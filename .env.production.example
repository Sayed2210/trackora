# Server
NODE_ENV=production
PORT=3000
CORS_ORIGINS=https://your-frontend-domain.com

# Database - use production PostgreSQL/RDS, not local Docker
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/trackora?schema=public

# Redis - matches current RedisService implementation
REDIS_HOST=HOST
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT - must be a strong random secret in production
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AWS
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
