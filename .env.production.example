# Server
NODE_ENV=production
PORT=3000
CORS_ORIGINS=https://your-frontend-domain.com

# Database - single-server Docker production
POSTGRES_USER=trackora
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=trackora
DATABASE_URL=postgresql://trackora:change-this-postgres-password@db:5432/trackora?schema=public

# Redis - single-server Docker production
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-this-redis-password

# JWT - must be a strong random secret in production
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AWS
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
